PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://campus_user:campus_password@localhost:5432/campusconnect_db?schema=public"
JWT_ACCESS_SECRET="your_access_secret_here"
JWT_REFRESH_SECRET="your_refresh_secret_here"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Email Configuration (Nodemailer)
# Option 1: Gmail (App Password required: myaccount.google.com/apppasswords)
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASS="your-16-char-app-password"

# Option 2: Custom SMTP (SendGrid, Mailgun, Brevo, AWS SES, etc.)
SMTP_HOST="smtp.mailprovider.com"
SMTP_PORT="587"
SMTP_USER="apikey"
SMTP_PASS="your_api_key_or_password"
EMAIL_FROM="noreply@campusconnect.edu"
